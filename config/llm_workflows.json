  "llm_transactions": [
    {
      "id": "full_artifact_bundle",
      "label": "Full artifact bundle",
      "kind": "full_analysis",
      "requires_vision": true,
      "output_keys": ["objects_pl", "differences_pl", "similarities_pl", "turtle_from_image_pl", "turtle_from_diff_pl", "rules_pl"],
      "input_files": ["object_registry.pl", "objects.pl", "differences.pl", "similarities.pl", "turtle_from_image.pl", "turtle_from_diff.pl", "rules.pl"]
    },
    {
      "id": "extract_scene_objects",
      "label": "Extract objects from before/current images",
      "kind": "llm_artifacts",
      "requires_vision": true,
      "include_parent_image": true,
      "include_current_image": true,
      "output_keys": ["objects_pl", "turtle_from_image_pl"],
      "input_files": ["object_registry.pl"],
      "instructions": "Extract semantic objects and a faithful Turtle reconstruction. Propose only genuinely new friendly identities.",
      "combine_safe": true
    },
    {
      "id": "explain_object_changes",
      "label": "Explain object and Turtle changes",
      "kind": "llm_artifacts",
      "requires_vision": false,
      "include_parent_image": false,
      "include_current_image": false,
      "output_keys": ["differences_pl", "similarities_pl", "turtle_from_diff_pl"],
      "input_files": ["object_registry.pl", "objects.pl", "turtle_from_image.pl", "differences.pl", "similarities.pl", "turtle_from_diff.pl"],
      "instructions": "Use the symbolic object and Turtle files to explain exactly what changed.",
      "combine_safe": true
    },
    {
      "id": "induce_rules_from_prolog",
      "label": "Induce rules from Prolog evidence",
      "kind": "llm_artifacts",
      "requires_vision": false,
      "include_parent_image": false,
      "include_current_image": false,
      "output_keys": ["rules_pl"],
      "input_files": ["object_registry.pl", "objects.pl", "differences.pl", "similarities.pl", "turtle_from_image.pl", "turtle_from_diff.pl", "rules.pl"],
      "instructions": "Induce conservative rules from the supplied Prolog evidence.",
      "combine_safe": false
    },
    {
      "id": "audit_artifact_bundle",
      "label": "Audit artifact bundle",
      "kind": "llm_text",
      "requires_vision": false,
      "include_parent_image": false,
      "include_current_image": false,
      "output_file": "artifact_audit.md",
      "input_files": ["object_registry.pl", "objects.pl", "differences.pl", "similarities.pl", "turtle_from_image.pl", "turtle_from_diff.pl", "rules.pl"],
      "instructions": "Audit the bundle and return strict JSON containing audit_md.",
      "combine_safe": false
    },
    {
      "id": "prolog_render_symbolic_evidence",
      "label": "Render symbolic evidence with Prolog",
      "kind": "runner_method",
      "runner_method": "prolog_command_4",
      "requires_vision": false,
      "combine_safe": false
    }
  ],
  "llm_workflows": [
    {
      "id": "level4_then_prolog_review",
      "label": "Selected model Level 4, Prolog cherry-pick, final audit",
      "description": "Preserves the normal pick-a-model-and-run-level-4 workflow, then optionally lets Prolog cherry-pick evidence and performs a light consistency audit.",
      "steps": [
        {"id": "level4", "transaction": "full_artifact_bundle", "model": "$selected", "analysis_level": 4},
        {"id": "prolog", "transaction": "prolog_render_symbolic_evidence"},
        {"id": "audit", "transaction": "audit_artifact_bundle", "profile": "openai-gpt-5.6-light", "continue_on_error": true}
      ]
    },
    {
      "id": "staged_symbolic_analysis",
      "label": "Staged OpenAI, Groq, Prolog, rules, and audit",
      "description": "Extract objects from images, explain symbolic changes, render with Prolog, induce rules from the generated Prolog, and audit the final bundle.",
      "steps": [
        {"id": "objects", "transaction": "extract_scene_objects", "profile": "openai-gpt-5.6-light", "combine_group": "perception"},
        {"id": "changes", "transaction": "explain_object_changes", "profile": "groq-qwen-3.6-27b-deep"},
        {"id": "prolog", "transaction": "prolog_render_symbolic_evidence"},
        {"id": "rules", "transaction": "induce_rules_from_prolog", "profile": "openrouter-nemotron-3-ultra-rules"},
        {"id": "audit", "transaction": "audit_artifact_bundle", "profile": "openai-gpt-5.6-light", "continue_on_error": true}
      ]
    },
    {
      "id": "free_staged_symbolic_analysis",
      "label": "All-free staged symbolic analysis",
      "description": "Uses a verified free vision model for perception and verified free text/code models for symbolic change explanation, rule induction, and auditing.",
      "steps": [
        {"id": "objects", "transaction": "extract_scene_objects", "profile": "openrouter-gemma-4-26b-a4b-deep"},
        {"id": "changes", "transaction": "explain_object_changes", "profile": "openrouter-nemotron-3-nano-changes"},
        {"id": "prolog", "transaction": "prolog_render_symbolic_evidence"},
        {"id": "rules", "transaction": "induce_rules_from_prolog", "profile": "openrouter-north-mini-code-rules"},
        {"id": "audit", "transaction": "audit_artifact_bundle", "profile": "openrouter-gpt-oss-20b-audit", "continue_on_error": true}
      ]
    }
  ]
