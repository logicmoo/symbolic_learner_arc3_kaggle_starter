  "llm_transactions": [
    {
      "id": "full_artifact_bundle",
      "label": "Full artifact bundle",
      "kind": "full_analysis",
      "requires_vision": true,
      "output_keys": ["objects_pl", "differences_pl", "similarities_pl", "turtle_from_image_pl", "turtle_from_diff_pl", "rules_pl"],
      "input_files": ["object_registry.pl", "objects.pl", "differences.pl", "similarities.pl", "turtle_from_image.pl", "turtle_from_diff.pl", "rules.pl"]
    },
    {
      "id": "extract_scene_objects",
      "label": "Extract objects from before/current images",
      "kind": "llm_artifacts",
      "requires_vision": true,
      "include_parent_image": true,
      "include_current_image": true,
      "output_keys": ["objects_pl", "turtle_from_image_pl"],
      "input_files": ["object_registry.pl"],
      "instructions": "Extract semantic objects and a faithful Turtle reconstruction. Propose only genuinely new friendly identities.",
      "combine_safe": true
    },
    {
      "id": "explain_object_changes",
      "label": "Explain object and Turtle changes",
      "kind": "llm_artifacts",
      "requires_vision": false,
      "include_parent_image": false,
      "include_current_image": false,
      "output_keys": ["differences_pl", "similarities_pl", "turtle_from_diff_pl"],
      "input_files": ["object_registry.pl", "objects.pl", "turtle_from_image.pl", "differences.pl", "similarities.pl", "turtle_from_diff.pl"],
      "instructions": "Use the symbolic object and Turtle files to explain exactly what changed.",
      "combine_safe": true
    },
    {
      "id": "induce_rules_from_prolog",
      "label": "Induce rules from Prolog evidence",
      "kind": "llm_artifacts",
      "requires_vision": false,
      "include_parent_image": false,
      "include_current_image": false,
      "output_keys": ["rules_pl"],
      "input_files": ["object_registry.pl", "objects.pl", "differences.pl", "similarities.pl", "turtle_from_image.pl", "turtle_from_diff.pl", "rules.pl"],
      "instructions": "Induce conservative rules from the supplied Prolog evidence.",
      "combine_safe": false
    },
    {
      "id": "audit_artifact_bundle",
      "label": "Audit artifact bundle",
      "kind": "llm_text",
      "requires_vision": false,
      "include_parent_image": false,
      "include_current_image": false,
      "output_file": "artifact_audit.md",
      "input_files": ["object_registry.pl", "objects.pl", "differences.pl", "similarities.pl", "turtle_from_image.pl", "turtle_from_diff.pl", "rules.pl"],
      "instructions": "Audit the bundle and return strict JSON containing audit_md.",
      "combine_safe": false
    },
    {
      "id": "prolog_render_symbolic_evidence",
      "label": "Render symbolic evidence with Prolog",
      "kind": "runner_method",
      "runner_method": "prolog_command_4",
      "requires_vision": false,
      "combine_safe": false
    }
  ],
  "llm_workflows": [
    {
      "id": "level4_then_prolog_review",
      "label": "Selected model Level 4, Prolog cherry-pick, final audit",
      "description": "Preserves the normal pick-a-model-and-run-level-4 workflow, then optionally lets Prolog cherry-pick evidence and performs a light consistency audit.",
      "steps": [
        {"id": "level4", "transaction": "full_artifact_bundle", "model": "$selected", "analysis_level": 4},
        {"id": "prolog", "transaction": "prolog_render_symbolic_evidence"},
        {"id": "audit", "transaction": "audit_artifact_bundle", "profile": "openai-gpt-5.6-light", "continue_on_error": true}
      ]
    },
    {
      "id": "staged_symbolic_analysis",
      "label": "Staged OpenAI, Groq, Prolog, rules, and audit",
      "description": "Extract objects from images, explain symbolic changes, render with Prolog, induce rules from the generated Prolog, and audit the final bundle.",
      "steps": [
        {"id": "objects", "transaction": "extract_scene_objects", "profile": "openai-gpt-5.6-light", "combine_group": "perception"},
        {"id": "changes", "transaction": "explain_object_changes", "profile": "groq-qwen-3.6-27b-deep"},
        {"id": "prolog", "transaction": "prolog_render_symbolic_evidence"},
        {"id": "rules", "transaction": "induce_rules_from_prolog", "profile": "openrouter-nemotron-3-ultra-rules"},
        {"id": "audit", "transaction": "audit_artifact_bundle", "profile": "openai-gpt-5.6-light", "continue_on_error": true}
      ]
    },
    {
      "id": "free_staged_symbolic_analysis",
      "label": "All-free staged symbolic analysis",
      "description": "Uses a verified free vision model for perception and verified free text/code models for symbolic change explanation, rule induction, and auditing.",
      "steps": [
        {"id": "objects", "transaction": "extract_scene_objects", "profile": "openrouter-gemma-4-26b-a4b-deep"},
        {"id": "changes", "transaction": "explain_object_changes", "profile": "openrouter-nemotron-3-nano-changes"},
        {"id": "prolog", "transaction": "prolog_render_symbolic_evidence"},
        {"id": "rules", "transaction": "induce_rules_from_prolog", "profile": "openrouter-north-mini-code-rules"},
        {"id": "audit", "transaction": "audit_artifact_bundle", "profile": "openrouter-gpt-oss-20b-audit", "continue_on_error": true}
      ]
    },
    {
      "id": "arc3_objectify_observation",
      "kind": "subworkflow",
      "label": "Subworkflow: objectify one ARC3 observation",
      "description": "Normalize an observation, extract stable objects, synchronize image/Prolog/Turtle forms, and render the Turtle programs.",
      "input_slots": {"images": "source_images"},
      "output_slots": {"object_manifest": "object_manifest", "turtle_images": "turtle_images"},
      "steps": [
        {"id": "normalize", "task": "normalize_image_collection", "implementation": "pillow_png", "inputs": {"images": "source_images"}, "outputs": {"images": "normalized_images", "manifest": "normalized_manifest"}},
        {"id": "extract_objects", "task": "extract_individual_objects", "implementation": "vision_llm", "profile": "openai-gpt-5.6-light", "inputs": {"images": "normalized_images"}, "outputs": {"objects": "objects", "object_manifest": "object_manifest", "turtle": "turtle_programs"}},
        {"id": "synchronize", "task": "synchronize_object_representations", "implementation": "python_manifest", "inputs": {"objects": "objects", "images": "normalized_images"}, "outputs": {"object_manifest": "object_manifest"}},
        {"id": "render_turtle", "task": "turtlized_objects_to_images", "implementation": "python_turtle_renderer", "inputs": {"turtle": "turtle_programs", "objects": "object_manifest"}, "outputs": {"images": "turtle_images", "render_manifest": "turtle_render_manifest"}}
      ]
    },
    {
      "id": "arc3_capture_and_objectify",
      "kind": "subworkflow",
      "label": "Subworkflow: capture and objectify current ARC3 state",
      "description": "Capture the runner's current state and reuse the objectification subworkflow.",
      "input_slots": {},
      "output_slots": {"images": "captured_images", "object_manifest": "object_manifest", "turtle_images": "turtle_images"},
      "steps": [
        {"id": "capture", "task": "grab_image_source", "implementation": "arc3_state", "outputs": {"images": "captured_images", "manifest": "captured_manifest"}},
        {"id": "objectify", "subworkflow": "arc3_objectify_observation", "inputs": {"images": "captured_images"}, "outputs": {"object_manifest": "object_manifest", "turtle_images": "turtle_images"}}
      ]
    },
    {
      "id": "arc3_analyze_demonstration",
      "kind": "subworkflow",
      "label": "Subworkflow: analyze before/action/after",
      "description": "Compare objectified states and produce transition evidence for one human demonstration.",
      "input_slots": {"before": "before_scene", "after": "after_scene", "objects": "object_manifest"},
      "output_slots": {"transition": "transition_evidence"},
      "steps": [
        {"id": "compare", "task": "compare_scene_objects", "implementation": "symbolic_llm", "profile": "groq-qwen-3.6-27b-deep", "inputs": {"before": "before_scene", "after": "after_scene", "objects": "object_manifest"}, "outputs": {"transition": "transition_evidence"}}
      ]
    },
    {
      "id": "arc3_update_world_understanding",
      "kind": "subworkflow",
      "label": "Subworkflow: update world rules and evidence",
      "description": "Induce candidate dynamics, validate the evidence bundle, publish a report, and ask whether to observe another action.",
      "input_slots": {"transition": "transition_evidence", "objects": "object_manifest", "next": "next_object_manifest"},
      "output_slots": {"rules": "candidate_rules", "report": "world_report", "current": "updated_current_object_manifest", "continue": "continue_observing"},
      "steps": [
        {"id": "induce_rules", "task": "induce_transition_rules", "implementation": "rule_llm", "profile": "openrouter-north-mini-code-rules", "inputs": {"transition": "transition_evidence", "objects": "object_manifest"}, "outputs": {"rules": "candidate_rules"}},
        {"id": "validate", "task": "validate_artifact_bundle", "implementation": "python_validator", "inputs": {"bundle": "artifact_bundle"}, "outputs": {"validation": "validation", "audit": "audit_report"}},
        {"id": "report", "task": "publish_workflow_report", "implementation": "markdown_report", "inputs": {"bundle": "artifact_bundle", "validation": "validation"}, "outputs": {"report": "world_report"}},
        {"id": "advance", "task": "advance_observation", "implementation": "slot_passthrough", "inputs": {"next": "next_object_manifest"}, "outputs": {"current": "updated_current_object_manifest"}},
        {"id": "continue", "task": "continue_human_observation", "implementation": "human_confirmation", "outputs": {"continue": "continue_observing"}}
      ]
    },
    {
      "id": "arc3_human_observation",
      "kind": "workflow",
      "mode": "human_demonstration",
      "label": "ARC3: learn a world by observing a human",
      "description": "Seven top-level stages. Running this from the workflow desktop starts ls20, objectifies the initial state, pauses for human actions, learns from transitions, and repeats while requested.",
      "repeat": {"from": "human_chooses_action", "while_slot": "continue_observing", "max_iterations": 1000},
      "steps": [
        {"id": "select_world", "task": "select_arc3_world", "implementation": "arc3_game_selector", "parameters": {"game_id": "ls20"}, "outputs": {"world": "selected_world"}},
        {"id": "capture_initial_observation", "task": "grab_image_source", "implementation": "arc3_state", "outputs": {"images": "current_images", "manifest": "current_image_manifest"}},
        {"id": "objectify_observation", "subworkflow": "arc3_objectify_observation", "inputs": {"images": "current_images"}, "outputs": {"object_manifest": "current_object_manifest", "turtle_images": "current_turtle_images"}},
        {"id": "human_chooses_action", "task": "await_human_arc3_action", "implementation": "interactive_runner_controls", "inputs": {"world": "selected_world"}, "outputs": {"intervention": "human_intervention"}},
        {"id": "capture_resulting_observation", "subworkflow": "arc3_capture_and_objectify", "inputs": {}, "outputs": {"images": "next_images", "object_manifest": "next_object_manifest", "turtle_images": "next_turtle_images"}},
        {"id": "analyze_transition", "subworkflow": "arc3_analyze_demonstration", "inputs": {"before": "current_object_manifest", "after": "next_object_manifest", "objects": "next_object_manifest"}, "outputs": {"transition": "transition_evidence"}},
        {"id": "update_world_understanding", "subworkflow": "arc3_update_world_understanding", "inputs": {"transition": "transition_evidence", "objects": "next_object_manifest", "next": "next_object_manifest"}, "outputs": {"rules": "candidate_rules", "report": "world_report", "current": "current_object_manifest", "continue": "continue_observing"}}
      ]
    }
  ]
}
