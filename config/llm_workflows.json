    "transaction_extract_scene_objects": [
      "TRANSACTION: Extract stable semantic objects from the requested before/current ARC images. Concentrate on object identity, geometry, topology, color, role, and motion-relevant substructure. Return only the artifact keys requested by the transaction."
    ],
    "transaction_explain_object_changes": [
      "TRANSACTION: Explain what changed using the supplied object, Turtle, and transition Prolog files as primary evidence. Prefer exact symbolic evidence over visual speculation. Return only the requested transition artifacts."
    ],
    "transaction_induce_rules_from_prolog": [
      "TRANSACTION: Read the supplied Prolog artifacts and induce conservative executable or testable rules. Separate direct observations from hypotheses, cite supporting predicates, and record contradictions. Return only rules_pl."
    ],
    "transaction_audit_artifact_bundle": [
      "TRANSACTION: Audit the complete artifact bundle for internal consistency. Check identities, coordinates, object facts, Turtle reconstructions, differences, similarities, and rules. Return strict JSON with one audit_md string."
    ]
  },
