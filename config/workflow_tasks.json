{
  "schema_version": 1,
  "title": "ARC3 Workflow Task Catalog",
  "datatypes_manifest": "workflow_datatypes.json",
  "tasks": [
    {
      "id": "grab_image_source",
      "label": "Grab image source",
      "description": "Acquire and normalize one or more source images before symbolic analysis.",
      "inputs": {"request": "source_request"},
      "outputs": {"images": "image_collection", "manifest": "image_manifest"},
      "implementations": [
        {"id":"arc3_state","label":"Pull from current ARC3 state","species":"python","handler":"grab_arc3_state"},
        {"id":"video_to_frames","label":"Video to sampled frames","species":"python","handler":"video_to_frames"},
        {"id":"ask_user_to_upload","label":"Ask user to choose/upload images","species":"python","handler":"ask_user_to_upload"},
        {"id":"disk_directory","label":"Pull images from disk directory","species":"python","handler":"images_from_disk_directory"},
        {"id":"clipboard_image","label":"Read an image from the clipboard","species":"python","handler":"clipboard_image"},
        {"id":"remote_image_url","label":"Download image from URL","species":"python","handler":"remote_image_url"},
        {"id":"camera_capture","label":"Capture one camera frame","species":"python","handler":"camera_capture"},
        {"id":"generated_test_pattern","label":"Generate deterministic ARC-like test images","species":"python","handler":"generated_test_pattern"}
      ]
    },
    {
      "id":"normalize_image_collection","label":"Normalize image collection","description":"Convert source images to consistent PNG files and create hashes/roles.",
      "inputs":{"images":"image_collection"},"outputs":{"images":"image_collection","manifest":"image_manifest"},
      "implementations":[{"id":"pillow_png","label":"Pillow PNG normalizer","species":"python","handler":"normalize_images"}]
    },
    {
      "id":"extract_individual_objects","label":"Extract individual objects","description":"Produce semantic objects and their visual/Turtle/Prolog representations.",
      "inputs":{"images":"image_collection"},"outputs":{"objects":"object_collection","object_manifest":"object_manifest","turtle":"turtle_program_file"},
      "implementations":[
        {"id":"vision_llm","label":"Vision LLM object extraction","species":"llm","transaction":"extract_scene_objects"},
        {"id":"full_selected_model","label":"Selected model full analysis","species":"llm","transaction":"full_artifact_bundle"}
      ]
    },
    {
      "id":"synchronize_object_representations","label":"Synchronize object representations","description":"Cross-link image regions, Turtle programs, and Prolog property sets for each individual object.",
      "inputs":{"objects":"object_collection","images":"image_collection"},"outputs":{"object_manifest":"object_manifest"},
      "implementations":[
        {"id":"python_manifest","label":"Python representation manifest","species":"python","handler":"synchronize_object_representations"},
        {"id":"llm_audit","label":"LLM semantic reconciliation","species":"llm","transaction":"audit_artifact_bundle"}
      ]
    },
    {
      "id":"turtlized_objects_to_images","label":"Turtlized objects to images","description":"Render Turtle programs associated with semantic objects into image files.",
      "inputs":{"turtle":"turtle_program_file","objects":"object_manifest"},"outputs":{"images":"image_collection","render_manifest":"render_manifest"},
      "implementations":[
        {"id":"python_turtle_renderer","label":"Python Turtle renderer","species":"python","handler":"render_turtle_artifacts"},
        {"id":"prolog_turtle_renderer","label":"Prolog Turtle renderer","species":"prolog","runner_method":"prolog_command_4"}
      ]
    },
    {
      "id":"images_displayer","label":"Images displayer","description":"Display or contact-sheet a collection of images for human inspection.",
      "inputs":{"images":"image_collection"},"outputs":{"display_session":"display_session"},
      "implementations":[
        {"id":"python_image_viewer","label":"Python/Pillow image viewer","species":"python","handler":"display_images"},
        {"id":"prolog_visualizer","label":"Prolog visualizer","species":"prolog","runner_method":"prolog_command_4"}
      ]
    },
    {
      "id":"compare_scene_objects","label":"Compare scene objects","description":"Explain differences and correspondences between before/current object representations.",
      "inputs":{"before":"scene","after":"scene","objects":"object_manifest"},"outputs":{"transition":"transition_evidence"},
      "implementations":[
        {"id":"symbolic_llm","label":"LLM symbolic change analysis","species":"llm","transaction":"explain_object_changes"},
        {"id":"prolog_difference","label":"Prolog difference analysis","species":"prolog","runner_method":"prolog_command_3"}
      ]
    },
    {
      "id":"induce_transition_rules","label":"Induce transition rules","description":"Generate conservative transition rules from symbolic evidence.",
      "inputs":{"transition":"transition_evidence","objects":"object_manifest"},"outputs":{"rules":"rule_set"},
      "implementations":[
        {"id":"rule_llm","label":"LLM rule induction","species":"llm","transaction":"induce_rules_from_prolog"},
        {"id":"prolog_rule_engine","label":"Prolog rule engine","species":"prolog","runner_method":"prolog_command_2"}
      ]
    },
    {
      "id":"prolog_cherry_pick_evidence","label":"Prolog cherry-pick evidence","description":"Let Prolog select, normalize, or reject generated evidence before downstream use.",
      "inputs":{"bundle":"artifact_bundle"},"outputs":{"bundle":"artifact_bundle","validation":"validation_report"},
      "implementations":[{"id":"prolog_full_analysis","label":"Prolog full analysis/cherry-pick","species":"prolog","runner_method":"prolog_command_2"}]
    },
    {
      "id":"validate_artifact_bundle","label":"Validate artifact bundle","description":"Check file presence, parseability, identities, image manifests, and cross-representation consistency.",
      "inputs":{"bundle":"artifact_bundle"},"outputs":{"validation":"validation_report","audit":"audit_report"},
      "implementations":[
        {"id":"python_validator","label":"Deterministic Python validator","species":"python","handler":"validate_artifact_bundle"},
        {"id":"llm_auditor","label":"LLM artifact auditor","species":"llm","transaction":"audit_artifact_bundle"}
      ]
    },
    {
      "id":"publish_workflow_report","label":"Publish workflow report","description":"Write a readable report of task execution, data slots, artifacts, warnings, and provenance.",
      "inputs":{"bundle":"artifact_bundle","validation":"validation_report"},"outputs":{"report":"workflow_report"},
      "implementations":[{"id":"markdown_report","label":"Python Markdown report","species":"python","handler":"publish_workflow_report"}]
    }
  ]
}
