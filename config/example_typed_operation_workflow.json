{
  "id": "typed_routed_artifact_pipeline",
  "label": "Typed routed pipeline: source → objects → Turtle images → rules → report",
  "description": "Demonstrates typed workflow slots and implementation species. Pulls images from ARC3 by default, but the first operation can be rerouted to video, upload, disk, clipboard, URL, camera, or generated images.",
  "steps": [
    {"id":"source","operation":"grab_image_source","implementation":"arc3_state","parameters":{},"outputs":{"images":"source_images","manifest":"source_manifest"}},
    {"id":"normalize","operation":"normalize_image_collection","implementation":"pillow_png","inputs":{"images":"source_images"},"outputs":{"images":"normalized_images","manifest":"normalized_manifest"}},
    {"id":"objects","operation":"extract_individual_objects","implementation":"vision_llm","profile":"openai-gpt-5.6-light","inputs":{"images":"normalized_images"},"outputs":{"objects":"scene_objects","object_manifest":"object_manifest","turtle":"turtle_programs"}},
    {"id":"sync_representations","operation":"synchronize_object_representations","implementation":"python_manifest","inputs":{"objects":"scene_objects","images":"normalized_images"},"outputs":{"object_manifest":"object_manifest"}},
    {"id":"render_turtle","operation":"turtlized_objects_to_images","implementation":"python_turtle_renderer","inputs":{"turtle":"turtle_programs","objects":"object_manifest"},"outputs":{"images":"turtle_images","render_manifest":"turtle_render_manifest"}},
    {"id":"display","operation":"images_displayer","implementation":"python_image_viewer","inputs":{"images":"turtle_images"},"outputs":{"display_session":"display_session"},"continue_on_error":true},
    {"id":"compare","operation":"compare_scene_objects","implementation":"symbolic_llm","profile":"groq-qwen-3.6-27b-deep","inputs":{"before":"source_manifest","after":"normalized_manifest","objects":"object_manifest"},"outputs":{"transition":"transition_evidence"}},
    {"id":"rules","operation":"induce_transition_rules","implementation":"rule_llm","profile":"openrouter-north-mini-code-rules","inputs":{"transition":"transition_evidence","objects":"object_manifest"},"outputs":{"rules":"rule_set"}},
    {"id":"cherry_pick","operation":"prolog_cherry_pick_evidence","implementation":"prolog_full_analysis","inputs":{"bundle":"artifact_bundle"},"outputs":{"bundle":"artifact_bundle","validation":"prolog_validation"},"continue_on_error":true},
    {"id":"validate","operation":"validate_artifact_bundle","implementation":"python_validator","inputs":{"bundle":"artifact_bundle"},"outputs":{"validation":"validation_report","audit":"audit_report"}},
    {"id":"report","operation":"publish_workflow_report","implementation":"markdown_report","inputs":{"bundle":"artifact_bundle","validation":"validation_report"},"outputs":{"report":"workflow_report"}}
  ]
}
