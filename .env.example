# LogicMOO Symbolic Learner ARC3 local environment
#
# Copy this file to `.env`, replace every EXAMPLE value, and keep `.env`
# private. The real `.env` file is ignored by Git.
#
# Windows paths use forward slashes here because they work cleanly in Python,
# dotenv files, Command Prompt, PowerShell, Git Bash, and most IDEs.

# -----------------------------------------------------------------------------
# Provider selection
# -----------------------------------------------------------------------------

# Initial provider selected by the multi-LLM router.
# Available checked-in ids: openai, claude, unsloth
ARC3_LLM_PROVIDER=unsloth

# Normally leave this at the checked-in provider registry.
ARC3_LLM_CONFIG=C:/symbolic_learner_arc3_kaggle_starter/config/llm_providers.json

# -----------------------------------------------------------------------------
# OpenAI / ChatGPT API
# -----------------------------------------------------------------------------

# Example only; obtain a real key from the OpenAI API account used for billing.
OPENAI_API_KEY=sk-proj-EXAMPLE0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJK
ARC3_OPENAI_MODEL=gpt-5.6

# Legacy direct-analyzer model setting. The provider router normally uses the
# provider-specific model above, but older entry points may still read this.
ARC3_GPT_MODEL=gpt-5.6

# -----------------------------------------------------------------------------
# Anthropic / Claude API
# -----------------------------------------------------------------------------

# Example only; obtain a real Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-api03-EXAMPLE0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJK
ARC3_CLAUDE_MODEL=claude-sonnet-4-20250514
ARC3_CLAUDE_BASE_URL=https://api.anthropic.com/v1

# -----------------------------------------------------------------------------
# Unsloth Studio local API
# -----------------------------------------------------------------------------

# Unsloth Studio requires a real API key for /v1/* even on localhost.
# Create it in Unsloth Studio: Settings > API Access (or Settings > API).
# Real keys begin with sk-unsloth-.
ARC3_UNSLOTH_API_KEY=sk-unsloth-EXAMPLE0123456789abcdefghijklmnopqrstuvwxyz

# Match this to the model currently loaded in Unsloth Studio.
ARC3_UNSLOTH_MODEL=unsloth/gemma-4-E2B-it-GGUF
ARC3_UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
ARC3_UNSLOTH_HEALTH_URL=http://127.0.0.1:8888/api/health

# -----------------------------------------------------------------------------
# Shared analysis profile overrides
# -----------------------------------------------------------------------------

# These override every numbered LLM analysis profile unless a profile-specific
# value below is set. Image detail values are usually low or high. Reasoning
# effort values are usually low, medium, or high where supported.
ARC3_GPT_IMAGE_DETAIL=high
ARC3_GPT_PARENT_IMAGE_DETAIL=low
ARC3_GPT_REASONING_EFFORT=medium
ARC3_GPT_MAX_OUTPUT_TOKENS=22000

# Command 2: demo profile
ARC3_GPT_2_IMAGE_DETAIL=low
ARC3_GPT_2_PARENT_IMAGE_DETAIL=low
ARC3_GPT_2_REASONING_EFFORT=low
ARC3_GPT_2_MAX_OUTPUT_TOKENS=12000

# Command 3: deep profile
ARC3_GPT_3_IMAGE_DETAIL=high
ARC3_GPT_3_PARENT_IMAGE_DETAIL=low
ARC3_GPT_3_REASONING_EFFORT=medium
ARC3_GPT_3_MAX_OUTPUT_TOKENS=22000

# Command 4: extreme profile
ARC3_GPT_4_IMAGE_DETAIL=high
ARC3_GPT_4_PARENT_IMAGE_DETAIL=high
ARC3_GPT_4_REASONING_EFFORT=high
ARC3_GPT_4_MAX_OUTPUT_TOKENS=32000

# -----------------------------------------------------------------------------
# Runtime and generated-artifact paths
# -----------------------------------------------------------------------------

ARC3_RUNTIME_HOME=C:/symbolic_learner_arc3_kaggle_starter
ARC3_PROMPTS_ROOT=C:/symbolic_learner_arc3_kaggle_starter/prompts
ARC3_TREE_ROOT=C:/symbolic_learner_arc3_kaggle_starter/action_trees

# Compatibility fallback for older launchers. New code uses ARC3_PROMPTS_ROOT.
ARC3_ENVIRONMENT_FILES=C:/symbolic_learner_arc3_kaggle_starter/prompts

# -----------------------------------------------------------------------------
# Browser debugger / WebSocket terminal
# -----------------------------------------------------------------------------

ARC3_WEB_HOST=127.0.0.1
ARC3_WEB_PORT=8765
ARC3_WEB_GAME=ls20
ARC3_WEB_RENDER_MODE=terminal
ARC3_WEB_ROWS=100
ARC3_WEB_COLS=320

# Required when binding ARC3_WEB_HOST outside loopback. Replace before exposing
# the terminal to a LAN, VPN, tunnel, or public interface.
ARC3_WEB_TOKEN=arc3-web-EXAMPLE-4Vq7hJ2mN9xR6sT8wY3zK5pL

# -----------------------------------------------------------------------------
# PyCharm remote debugger attachment
# -----------------------------------------------------------------------------

# Set to 1 only while PyCharm is listening for a debug connection. Keeping this
# at 0 avoids the startup delay and connection-refused message during normal use.
ARC3_PYCHARM_DEBUG=0
ARC3_PYCHARM_HOST=localhost
ARC3_PYCHARM_PORT=5678
ARC3_PYCHARM_SUSPEND=1
ARC3_PYCHARM_TIMEOUT=7
ARC3_PYCHARM_RETRY_INTERVAL=1
ARC3_PYCHARM_WAIT=0

# -----------------------------------------------------------------------------
# Kaggle CLI / protected submission workflow
# -----------------------------------------------------------------------------

# The Makefile normally reads the token from .kaggle/access_token. This value is
# useful for direct Kaggle CLI commands or IDE run configurations.
KAGGLE_API_TOKEN=KGAT_EXAMPLE0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJK
