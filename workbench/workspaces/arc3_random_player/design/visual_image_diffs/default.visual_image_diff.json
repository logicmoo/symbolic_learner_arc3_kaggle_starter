{
  "kind": "visual_image_diff",
  "id": "arc3.action3_then_action1",
  "label": "Visual Image Diff — ACTION3 then ACTION1",
  "description": "A filesystem-backed ARC3 image sequence for composing structured visual-difference analysis prompts.",
  "promptProfileId": "visual_image_diff.analysis_group",
  "runtimeWorkflowId": "free_staged_symbolic_analysis",
  "promptGroups": [
    {
      "id": "image_pair_command",
      "label": "IMAGE PAIR + COMMAND",
      "transaction": "inspect_image_pair_command",
      "operation": "vision.extract_scene_objects",
      "implementation": "vision.extract_scene_objects.automatic_llm",
      "focalGroup": "source_scene",
      "colorKey": "S1",
      "prompts": [
        "visual_image_diff.pipeline.source",
        "visual_image_diff.pipeline.normalize",
        "visual_image_diff.pipeline.objects"
      ]
    },
    {
      "id": "render_display",
      "label": "RENDER + DISPLAY",
      "transaction": "render_and_display_objects",
      "operation": "vision.extract_scene_objects",
      "implementation": "vision.extract_scene_objects.automatic_llm",
      "focalGroup": "rendered_scene",
      "parentGroup": "source_scene",
      "colorKey": "S2",
      "prompts": [
        "visual_image_diff.pipeline.sync_representations",
        "visual_image_diff.pipeline.render_turtle",
        "visual_image_diff.pipeline.display"
      ]
    },
    {
      "id": "compare",
      "label": "COMPARE",
      "transaction": "explain_object_changes",
      "operation": "symbolic.explain_object_changes",
      "focalGroup": "active_transition",
      "parentGroup": "rendered_scene",
      "colorKey": "S3",
      "prompts": [
        "visual_image_diff.pipeline.compare",
        "visual_image_diff.pipeline.cherry_pick"
      ]
    },
    {
      "id": "rules",
      "label": "INDUCE RULES",
      "transaction": "induce_rules_from_prolog",
      "operation": "symbolic.induce_rules",
      "focalGroup": "candidate_rules",
      "parentGroup": "active_transition",
      "colorKey": "S4",
      "prompts": ["visual_image_diff.pipeline.rules"]
    },
    {
      "id": "audit",
      "label": "VALIDATE + REPORT",
      "transaction": "audit_artifact_bundle",
      "operation": "artifact.audit_bundle",
      "continueOnError": true,
      "focalGroup": "artifact_release",
      "parentGroup": "candidate_rules",
      "colorKey": "S5",
      "prompts": [
        "visual_image_diff.pipeline.validate",
        "visual_image_diff.pipeline.report"
      ]
    }
  ],
  "frames": [
    {
      "id": "state_0",
      "label": "Sample image",
      "assetPath": "runtime/artifacts/visual_image_diff/state_0.png"
    },
    {
      "id": "state_1",
      "label": "After ACTION3",
      "assetPath": "runtime/artifacts/visual_image_diff/state_1.png"
    },
    {
      "id": "state_2",
      "label": "After ACTION1",
      "assetPath": "runtime/artifacts/visual_image_diff/state_2.png"
    }
  ],
  "commands": [
    {
      "fromFrameId": "state_0",
      "toFrameId": "state_1",
      "command": "ACTION3",
      "label": "ACTION3"
    },
    {
      "fromFrameId": "state_1",
      "toFrameId": "state_2",
      "command": "ACTION1",
      "label": "ACTION1"
    }
  ]
}
