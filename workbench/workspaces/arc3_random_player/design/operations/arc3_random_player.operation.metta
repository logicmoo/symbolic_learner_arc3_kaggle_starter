(
  (kind operation) (id arc3_random.select_game) (label "Select ARC Game") (categories ([] arc3/random-player))
  (description "Choose a live catalog entry while avoiding an immediate repeat.")
  (role abstract_stage) (inputs ((games Array) (previous_game_id Text) (seed Number)))
  (outputs ((game Object)))
  (children ([] arc3_random.select_game.random arc3_random.select_game.llm))
  (preferredChild arc3_random.select_game.random)
)
(
  (kind operation) (id arc3_random.select_game.random) (label "Select ARC Game / Select Random") (categories ([] arc3/random-player))
  (description "Select from the live games by delegating to the reusable Random List Element behavior.")
  (implementation python.callable) (inputs ((games Array) (previous_game_id Text) (seed Number)))
  (outputs ((game Object)))
  (python ((importMode file) (file python/arc3_random_player.py) (callable select_random_game)))
  (delegatesTo collection.random_list_element)
  (parameters ((outputBinding game))) (parents ([] arc3_random.select_game))
)
(
  (kind operation) (id arc3_random.select_game.llm) (label "Select ARC Game / Prompt") (categories ([] arc3/random-player))
  (description "Let a configured model choose from the live catalog without inventing games.")
  (implementation llm.complete) (inputs ((games Array) (previous_game_id Text) (seed Number)))
  (outputs ((game Object)))
  (bindings ((prompts ([] structured_json_response arc3_random.select_game)) (separator "\n\n")))
  (modelSelection ((models ([] openrouter/free)) (strategy single)))
  (parameters ((inputBinding games) (outputBinding game))) (parents ([] arc3_random.select_game))
)
