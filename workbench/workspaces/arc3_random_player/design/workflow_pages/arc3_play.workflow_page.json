          { "id": "arc3_play_games", "label": "ARC3 Games", "component": "Arc3PlayGameList", "initialDisplayMode": "scroll" }
        ]
      },
      {
        "id": "center",
        "label": "LIVE GAME",
        "role": "authoring",
        "members": [
          { "id": "arc3_play_board", "label": "Play & Record", "component": "Arc3PlayBoard", "initialDisplayMode": "scroll" }
        ]
      },
      {
