  (objects_pl "object(player_entity, agent, current).\nobject(plus_sign, trigger, current).\nobject(rotor_wheel, mechanism, current).\nobject(glyph_a, glyph, current).\nobject(glyph_b, glyph, current).\nobject(top_exit, exit, current).\nobject(path_corridor, corridor, current).\nobject(obstacle_cluster_a, obstacle, current).\nobject(hud_score_panel, hud, current).\nobject(g_player_plus_rotor, object_group, current).\nobject(g_glyph_pair, object_group, current).\nobject(g_exit_corridor, object_group, current).\ncomponent_of(player_entity, g_player_plus_rotor).\ncomponent_of(plus_sign, g_player_plus_rotor).\ncomponent_of(rotor_wheel, g_player_plus_rotor).\ncomponent_of(glyph_a, g_glyph_pair).\ncomponent_of(glyph_b, g_glyph_pair).\ncomponent_of(path_corridor, g_exit_corridor).\ncomponent_of(top_exit, g_exit_corridor).\nrole(plus_sign, trigger).\nrole(top_exit, goal_exit).\naligned_with(glyph_a, glyph_b, vertical).\nconfidence(rotor_wheel, 0.90).\nconfidence(g_glyph_pair, 0.85).")
  (differences_pl "transition_step(12).\ncommand_executed('UP').\ntouched(player_entity, plus_sign).\nrotated(rotor_wheel, degrees(90), direction(cw)).\ncaused_by(rotation_event_rotor_wheel, contact(player_entity, plus_sign)).\ndiff_turtle_patch(step_12_patch, [set_pos(22,8), set_color(rgb(255,255,0)), set_width(1), pendown, fwd(2), penup, rot(180), fwd(1), rot(90), pendown, fwd(1)]).")
  (similarities_pl "corresponds(player_entity_prev, player_entity).\ncorresponds(plus_sign_prev, plus_sign).\ncorresponds(rotor_wheel_prev, rotor_wheel).\ncorresponds(glyph_a_prev, glyph_a).\ncorresponds(glyph_b_prev, glyph_b).\ncorresponds(path_corridor_prev, path_corridor).\ncorresponds(g_glyph_pair_prev, g_glyph_pair).")
  (turtle_from_image_pl "turtle_program(player_entity, [set_pos(6,10), set_angle(0), set_color(rgb(255,255,255)), set_width(1), pendown, fwd(1)]).\nturtle_program(plus_sign, [set_pos(12,10), set_angle(90), set_color(rgb(0,255,255)), set_width(1), pendown, fwd(2), rot(180), fwd(1), rot(90), fwd(1), rot(180), fwd(2)]).\nturtle_program(rotor_wheel, [set_pos(18,10), set_angle(0), set_color(rgb(255,128,0)), set_width(1), pendown, fwd(2), rot(90), fwd(2), rot(90), fwd(2), rot(90), fwd(2)]).\nturtle_program(top_exit, [set_pos(22,4), set_angle(90), set_color(rgb(0,255,0)), set_width(1), pendown, fwd(2)]).")
  (rules_pl "hypothetical_rule(goal_progress, move_reduces_distance_to_exit, step_12).\nhypothetical_rule(level1_first_image_baseline, identities_anchor_to_first_image, step_scope(level_1)).\nconfidence(goal_progress, 0.66).\nconfidence(level1_first_image_baseline, 0.89).\nobserved_rule(contact_triggers_rotation, caused_by(rotation_event_rotor_wheel, contact(player_entity, plus_sign))).\nconfidence(contact_triggers_rotation, 0.84).")
  (objects_english "Level_1 object catalog is anchored to the first image baseline and reused across steps.\nplayer_entity, plus_sign, rotor_wheel, glyph_a, glyph_b, and top_exit are present.\nFormed object groups: player-trigger-rotor, glyph pair, and exit corridor assembly.")
  (differences_english "Command UP was applied at step 12.\nplayer touched plus_sign.\nrotation followed in rotor_wheel by about 90 degrees clockwise.")
  (rules_english "Baseline rule: use first-image object inventory as level_1 identity anchor.\nHypothesis: move choices should continue reducing distance to the escape route.\nObserved rule: player touched plus_sign and rotation followed.")
)
