{
  "kind": "backend",
  "id": "python",
  "label": "Python Runtime",
  "provider": "python",
  "description": "Executes trusted Python callables and Python-based task implementations.",
  "enabled": true,
  "capabilities": [
    "python.callable",
    "python.expression"
  ],
  "configuration": {
    "executable": "python",
    "isolation": "process",
    "timeoutSeconds": 300
  }
}
