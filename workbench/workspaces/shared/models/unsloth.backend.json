{
  "kind": "backend",
  "id": "unsloth",
  "label": "Unsloth Studio local",
  "provider": "unsloth",
  "official": true,
  "description": "Shared local Unsloth Studio OpenAI-compatible transport inherited by every workspace. Local model choices live in model files.",
  "enabled": true,
  "capabilities": [
    "llm.complete",
    "llm.vision",
    "llm.local"
  ],
  "configuration": {
    "adapter": "openai_responses",
    "baseUrl": "http://127.0.0.1:8888/v1",
    "apiKeyEnvironmentVariable": "WORKBENCH_UNSLOTH_API_KEY",
    "legacyApiKeyEnvironmentVariable": "ARC3_UNSLOTH_API_KEY",
    "baseUrlEnvironmentVariable": "WORKBENCH_UNSLOTH_BASE_URL",
    "legacyBaseUrlEnvironmentVariable": "ARC3_UNSLOTH_BASE_URL",
    "healthUrl": "http://127.0.0.1:8888/api/health",
    "healthUrlEnvironmentVariable": "WORKBENCH_UNSLOTH_HEALTH_URL",
    "legacyHealthUrlEnvironmentVariable": "ARC3_UNSLOTH_HEALTH_URL",
    "defaultModel": "unsloth/gemma-4-E2B-it-GGUF",
    "modelEnvironmentVariable": "WORKBENCH_UNSLOTH_MODEL",
    "legacyModelEnvironmentVariable": "ARC3_UNSLOTH_MODEL",
    "defaultAnalysisLevel": 3,
    "timeoutSeconds": 900
  }
}
