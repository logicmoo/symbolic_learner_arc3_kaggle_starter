    "topP": 0.95,
    "timeoutSeconds": 420,
    "currentImageDetail": "high",
    "parentImageDetail": "low"
  },
  "environment": {
    "model": "WORKBENCH_ANTHROPIC_MODEL",
    "legacyModel": "ARC3_CLAUDE_MODEL"
  }
}
