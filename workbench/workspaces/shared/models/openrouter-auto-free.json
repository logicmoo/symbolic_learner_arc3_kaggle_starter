{
  "kind": "model",
  "id": "openrouter-auto-free",
  "label": "OpenRouter automatic free",
  "description": "Automatic free-model routing through the shared OpenRouter backend catalog item.",
  "inherits": "openrouter",
  "model": "openrouter/free",
  "enabled": true,
  "capabilities": ["text", "vision", "reasoning", "json"],
  "defaults": {
    "reasoningEffort": "medium",
    "maxOutputTokens": 12000,
    "temperature": 0.1,
    "topP": 0.9,
    "timeoutSeconds": 420,
    "currentImageDetail": "high",
    "parentImageDetail": "low"
  }
}
