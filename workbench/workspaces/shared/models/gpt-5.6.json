{
  "kind": "model",
  "id": "gpt-5.6",
  "label": "GPT-5.6",
  "description": "OpenAI reasoning and multimodal model inheriting the shared OpenAI backend.",
  "backend": "openai",
  "model": "gpt-5.6",
  "enabled": true,
  "capabilities": ["text", "vision", "reasoning", "json"],
  "defaults": {
    "reasoningEffort": "high",
    "maxOutputTokens": 32000,
    "temperature": 0.0,
    "topP": 1.0,
    "timeoutSeconds": 900,
    "currentImageDetail": "high",
    "parentImageDetail": "high"
  },
  "environment": {
    "model": "WORKBENCH_OPENAI_MODEL",
    "legacyModel": "ARC3_OPENAI_MODEL"
  }
}
