{
  "kind": "backend",
  "id": "openrouter",
  "label": "OpenRouter",
  "provider": "openrouter",
  "official": true,
  "description": "Shared OpenRouter OpenAI-compatible transport inherited by every workspace. Individual OpenRouter models and presets live in model files.",
  "enabled": true,
  "capabilities": ["llm.complete", "llm.reasoning", "llm.vision"],
  "configuration": {
    "adapter": "openai_responses",
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKeyEnvironmentVariable": "OPENROUTER_API_KEY",
    "baseUrlEnvironmentVariable": "WORKBENCH_OPENROUTER_BASE_URL",
    "legacyBaseUrlEnvironmentVariable": "ARC3_OPENROUTER_BASE_URL",
    "defaultModel": "openrouter/free",
    "modelEnvironmentVariable": "WORKBENCH_OPENROUTER_MODEL",
    "legacyModelEnvironmentVariable": "ARC3_OPENROUTER_MODEL",
    "defaultAnalysisLevel": 3,
    "timeoutSeconds": 900
  }
}
