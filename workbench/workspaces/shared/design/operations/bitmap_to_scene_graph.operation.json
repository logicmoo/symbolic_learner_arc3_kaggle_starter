{
  "kind": "operation",
  "id": "bitmap_to_scene_graph",
  "label": "Bitmap to Scene Graph",
  "description": "Convert an image from bitmap representation to scene-graph representation without changing its abstract datatype.",
  "categories": ["vision/conversion", "vision/grouping", "datatypes/representation"],
  "inputs": {
    "image": {"datatype": "image", "representation": "bitmap"}
  },
  "outputs": {
    "image": {"datatype": "image", "representation": "scene_graph"}
  },
  "conversion": {
    "datatype": "image",
    "from": "bitmap",
    "to": "scene_graph"
  }
}
