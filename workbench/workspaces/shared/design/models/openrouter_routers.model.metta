(
  (kind model)
  (id openrouter-auto-router)
  (label "OpenRouter Auto Router")
  (description "Automatically selects a model for the prompt from task fit and observed OpenRouter usage. The former openrouter/auto ID is deprecated; this resource uses openrouter/auto-beta.")
  (inherits openrouter)
  (model openrouter/auto-beta)
  (enabled false)
  (categories ([] models/openrouter models/routers))
  (capabilities ([] text vision reasoning json tools))
  (properties (
    (router true)
    (deprecatedAliases ([] openrouter/auto))
  ))
)

(
  (kind model)
  (id openrouter-body-builder)
  (label "OpenRouter Body Builder")
  (description "Transforms natural-language requests into structured OpenRouter API request bodies for tasks that may run across multiple models in parallel.")
  (inherits openrouter)
  (model openrouter/bodybuilder)
  (enabled false)
  (categories ([] models/openrouter models/routers))
  (capabilities ([] text json tools))
  (properties ((router true)))
)

(
  (kind model)
  (id openrouter-free-router)
  (label "OpenRouter Free Models Router")
  (description "Randomly selects an available free model that supports the request's required features, including images and tools when needed.")
  (inherits openrouter)
  (model openrouter/free)
  (enabled true)
  (categories ([] models/openrouter models/routers))
  (capabilities ([] text vision reasoning json tools))
  (properties ((router true) (free true)))
)

(
  (kind model)
  (id openrouter-fusion-router)
  (label "OpenRouter Fusion Router")
  (description "Runs a panel of models in parallel, analyzes their responses, and synthesizes a stronger final response.")
  (inherits openrouter)
  (model openrouter/fusion)
  (enabled false)
  (categories ([] models/openrouter models/routers))
  (capabilities ([] text reasoning))
  (properties ((router true) (parallel true) (synthesizesResponses true)))
)

(
  (kind model)
  (id openrouter-latest-model-resolution)
  (label "OpenRouter Latest Model Resolution")
  (description "OpenRouter alias pattern that resolves to the newest version of a selected author's model family, for example ~anthropic/claude-opus-latest.")
  (inherits openrouter)
  (model ~author/family-latest)
  (enabled false)
  (categories ([] models/openrouter models/routers))
  (capabilities ([] text))
  (properties ((router true) (aliasPattern true)))
)

(
  (kind model)
  (id openrouter-pareto-code-router)
  (label "OpenRouter Pareto Code Router")
  (description "Routes coding requests through OpenRouter's Pareto code router.")
  (inherits openrouter)
  (model openrouter/pareto-code)
  (enabled false)
  (categories ([] models/openrouter models/routers models/code))
  (capabilities ([] text code tools reasoning))
  (properties ((router true) (coding true)))
)
