(
  (kind profile)
  (id unsloth-gemma-4-e2b-extreme)
  (label "Gemma 4 E2B local — extreme")
  (description "Prompt-free execution profile migrated from the legacy ARC3 configuration.")
  (inherits unsloth-gemma-4-e2b)
  (enabled true)
  (defaults (
    (analysisLevel 4)
    (singleEnabled true)
    (batchEnabled false)
    (maxOutputTokens 28000)
    (temperature 0.0)
    (topP 1.0)
    (reasoningEffort high)
    (currentImageDetail high)
    (parentImageDetail high)
    (timeoutSeconds 1200)
    (seed null)
  ))
)
