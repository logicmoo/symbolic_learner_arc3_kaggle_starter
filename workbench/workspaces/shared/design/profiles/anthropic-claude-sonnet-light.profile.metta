({}
  (kind profile)
  (id anthropic-claude-sonnet-light)
  (label "Claude Sonnet — light")
  (description "Prompt-free execution profile migrated from the legacy ARC3 configuration.")
  (inherits claude-sonnet)
  (enabled true)
  (defaults ({}
    (analysisLevel 2)
    (singleEnabled true)
    (batchEnabled false)
    (maxOutputTokens 10000)
    (temperature 0.1)
    (topP 0.95)
    (reasoningEffort low)
    (currentImageDetail low)
    (parentImageDetail low)
    (timeoutSeconds 180)
    (seed null)
  ))
)
