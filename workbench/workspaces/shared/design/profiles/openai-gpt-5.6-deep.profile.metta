({}
  (kind profile)
  (id openai-gpt-5.6-deep)
  (label "GPT-5.6 — deep")
  (description "Prompt-free execution profile migrated from the legacy ARC3 configuration.")
  (inherits gpt-5.6)
  (enabled true)
  (defaults ({}
    (analysisLevel 3)
    (singleEnabled true)
    (batchEnabled false)
    (maxOutputTokens 22000)
    (temperature 0.05)
    (topP 0.95)
    (reasoningEffort medium)
    (currentImageDetail high)
    (parentImageDetail low)
    (timeoutSeconds 420)
    (seed null)
  ))
)
