({}
  (kind profile)
  (id openai-gpt-5.6-extreme)
  (label "GPT-5.6 — extreme")
  (description "Prompt-free execution profile migrated from the legacy ARC3 configuration.")
  (inherits gpt-5.6)
  (enabled true)
  (defaults ({}
    (analysisLevel 4)
    (singleEnabled true)
    (batchEnabled false)
    (maxOutputTokens 32000)
    (temperature 0.0)
    (topP 1.0)
    (reasoningEffort high)
    (currentImageDetail high)
    (parentImageDetail high)
    (timeoutSeconds 900)
    (seed null)
  ))
)
