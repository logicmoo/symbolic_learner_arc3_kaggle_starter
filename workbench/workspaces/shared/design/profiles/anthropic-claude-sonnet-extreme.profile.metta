({}
  (kind profile)
  (id anthropic-claude-sonnet-extreme)
  (label "Claude Sonnet — extreme")
  (description "Prompt-free execution profile migrated from the legacy ARC3 configuration.")
  (inherits claude-sonnet)
  (enabled true)
  (defaults ({}
    (analysisLevel 4)
    (singleEnabled true)
    (batchEnabled false)
    (maxOutputTokens 28000)
    (temperature 0.0)
    (topP 1.0)
    (reasoningEffort high)
    (currentImageDetail high)
    (parentImageDetail high)
    (timeoutSeconds 900)
    (seed null)
  ))
)
