({}
  (kind profile)
  (id openrouter-nemotron-omni-light)
  (label "Nemotron 3 Nano Omni free — light")
  (description "Prompt-free execution profile migrated from the legacy ARC3 configuration.")
  (inherits openrouter-nemotron-omni)
  (enabled true)
  (defaults ({}
    (analysisLevel 2)
    (singleEnabled true)
    (batchEnabled false)
    (maxOutputTokens 8000)
    (temperature 0.1)
    (topP 0.9)
    (reasoningEffort low)
    (currentImageDetail low)
    (parentImageDetail low)
    (timeoutSeconds 240)
    (seed null)
  ))
)
