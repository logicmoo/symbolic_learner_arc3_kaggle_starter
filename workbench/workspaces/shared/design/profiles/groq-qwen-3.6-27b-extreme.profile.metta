(
  (kind profile)
  (id groq-qwen-3.6-27b-extreme)
  (label "Qwen 3.6 27B on Groq — extreme")
  (description "Prompt-free execution profile migrated from the legacy ARC3 configuration.")
  (inherits qwen-3.6-27b-groq)
  (enabled true)
  (defaults (
    (analysisLevel 4)
    (singleEnabled true)
    (batchEnabled false)
    (maxOutputTokens 18000)
    (temperature 0.0)
    (topP 1.0)
    (reasoningEffort high)
    (currentImageDetail high)
    (parentImageDetail high)
    (timeoutSeconds 600)
    (seed null)
  ))
)
