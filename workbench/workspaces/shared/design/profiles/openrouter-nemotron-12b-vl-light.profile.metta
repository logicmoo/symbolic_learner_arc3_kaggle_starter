({}
  (kind profile)
  (id openrouter-nemotron-12b-vl-light)
  (label "Nemotron Nano 12B 2 VL free — light")
  (description "Prompt-free execution profile migrated from the legacy ARC3 configuration.")
  (inherits openrouter-nemotron-12b-vl)
  (enabled true)
  (defaults ({}
    (analysisLevel 2)
    (singleEnabled true)
    (batchEnabled false)
    (maxOutputTokens 7000)
    (temperature 0.15)
    (topP 0.9)
    (reasoningEffort low)
    (currentImageDetail low)
    (parentImageDetail low)
    (timeoutSeconds 240)
    (seed null)
  ))
)
