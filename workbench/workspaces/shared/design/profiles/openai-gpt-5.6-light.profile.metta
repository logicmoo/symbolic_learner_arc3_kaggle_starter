({}
  (kind profile)
  (id openai-gpt-5.6-light)
  (label "GPT-5.6 — light")
  (description "Prompt-free execution profile migrated from the legacy ARC3 configuration.")
  (inherits gpt-5.6)
  (enabled true)
  (defaults ({}
    (analysisLevel 2)
    (singleEnabled true)
    (batchEnabled false)
    (maxOutputTokens 12000)
    (temperature 0.1)
    (topP 0.95)
    (reasoningEffort low)
    (currentImageDetail low)
    (parentImageDetail low)
    (timeoutSeconds 180)
    (seed null)
  ))
)
