({}
  (kind profile)
  (id anthropic-claude-sonnet-deep)
  (label "Claude Sonnet — deep")
  (description "Prompt-free execution profile migrated from the legacy ARC3 configuration.")
  (inherits claude-sonnet)
  (enabled true)
  (defaults ({}
    (analysisLevel 3)
    (singleEnabled true)
    (batchEnabled false)
    (maxOutputTokens 18000)
    (temperature 0.05)
    (topP 0.95)
    (reasoningEffort medium)
    (currentImageDetail high)
    (parentImageDetail low)
    (timeoutSeconds 420)
    (seed null)
  ))
)
