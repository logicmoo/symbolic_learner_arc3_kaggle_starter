{
  "kind": "backend",
  "id": "openai",
  "label": "GPT-5.6",
  "provider": "openai",
  "description": "Shared OpenAI Responses/API backend inherited by every workspace.",
  "enabled": true,
  "capabilities": ["llm.complete", "llm.reasoning", "llm.vision"],
  "configuration": {
    "adapter": "openai_responses",
    "baseUrl": "https://api.openai.com/v1",
    "apiKeyEnvironmentVariable": "OPENAI_API_KEY",
    "defaultModel": "gpt-5.6",
    "modelEnvironmentVariable": "ARC3_OPENAI_MODEL",
    "defaultAnalysisLevel": 4,
    "timeoutSeconds": 900
  }
}
