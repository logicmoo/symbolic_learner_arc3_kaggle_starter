{
  "kind": "model_policy",
  "id": "default_model_runtime",
  "label": "Default Model Runtime Policy",
  "description": "Abstract shared policy controlling wanted, runtime, benchmark, health, and fallback behavior.",
  "enabled": true,
  "example": true,
  "variantSelection": {
    "default": "balanced_model_runtime",
    "variants": ["balanced_model_runtime", "economy_model_runtime"]
  },
  "rules": {
    "requireHealthyVendor": true,
    "requireHealthyModel": true,
    "allowWantedAuto": true,
    "excludeSlowFromRuntime": true,
    "slowLatencyMs": 5000,
    "maxFailureRate": 0.2,
    "continueConcurrentPingsOnFailure": true
  }
}
