(
  (kind workflow)
  (id message_to_microatoms)
  (label "Message to MicroAtoms")
  (description "Capture an OmegaClaw exchange, stage its smallest meaningful facts, review annotations, and persist a provenance-bearing micro-atom record.")
  (inputs (
    (message Object)
    (conversation_context Object)
    (weaker_model_without_memory Object)
    (weaker_model_with_memory Object)
  ))
  (outputs (
    (microatoms $microatom_record)
    (groundingEvidence $memory_grounding_evidence)
  ))
  (steps ([]
    (
      (id capture_exchange)
      (label "Capture exchange")
      (kind operation)
      (operation shared.capture_agent_exchange)
      (implementation core.echo)
      (inputs ((value $message)))
      (outputs ((value captured_message)))
    )
    (
      (id stage_microatoms)
      (label "Stage micro-atoms")
      (kind operation)
      (operation shared.stage_microatoms)
      (implementation core.echo)
      (dependsOn ([] capture_exchange))
      (inputs ((value $captured_message)))
      (outputs ((value staged_microatoms)))
    )
    (
      (id review_annotations)
      (label "Review atom annotations")
      (kind human)
      (dependsOn ([] stage_microatoms))
      (form ((annotations ((type Object)))))
      (outputs ((annotations reviewed_annotations)))
    )
    (
      (id persist_microatom_record)
      (label "Persist micro-atom record")
      (kind operation)
      (operation shared.publish_memory_record)
      (implementation core.merge)
      (dependsOn ([] stage_microatoms review_annotations))
      (inputs ((left $staged_microatoms) (right $conversation_context)))
      (outputs ((value microatom_record)))
    )
    (
      (id run_weaker_without_memory)
      (label "Run weaker model without memory")
      (kind operation)
      (operation shared.run_weaker_model_control)
      (implementation core.echo)
      (dependsOn ([] persist_microatom_record))
      (inputs ((value $weaker_model_without_memory)))
      (outputs ((value weaker_without_memory)))
    )
    (
      (id run_weaker_with_memory)
      (label "Run weaker model with stored memory")
      (kind operation)
      (operation shared.run_weaker_model_control)
      (implementation core.echo)
      (dependsOn ([] persist_microatom_record))
      (inputs ((value $weaker_model_with_memory)))
      (outputs ((value weaker_with_memory)))
    )
    (
      (id compare_weaker_model_controls)
      (label "Compare weaker-model controls")
      (kind operation)
      (operation shared.compare_memory_grounding)
      (implementation core.merge)
      (dependsOn ([] run_weaker_without_memory run_weaker_with_memory))
      (inputs ((left $weaker_without_memory) (right $weaker_with_memory)))
      (outputs ((value weaker_control_comparison)))
    )
    (
      (id report_memory_grounding)
      (label "Report memory-grounding evidence")
      (kind operation)
      (operation shared.compare_memory_grounding)
      (implementation core.merge)
      (dependsOn ([] persist_microatom_record compare_weaker_model_controls))
      (inputs ((left $microatom_record) (right $weaker_control_comparison)))
      (outputs ((value memory_grounding_evidence)))
    )
  ))
)
