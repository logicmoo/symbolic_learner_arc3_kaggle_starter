(
  (kind workflow)
  (id atom_ant_symbolic_reasoning)
  (label "Atom.Ant Symbolic Reasoning Loop")
  (description "Run LLM-style reasoning, generate Atomese, assess symbolic coverage, try a bounded sequence of repairs until an adequate candidate is found, then execute and report.")
  (generation (
    (operation workflow.populate_from_english)
    (englishDescriptionPath docs/WORKFLOW_DESCRIPTION.md)
    (operationCategories ([] workflow-language))
    (preflightRequired true)
  ))
  (inputs (
    (request Any)
    (repair_candidates Array)
  ))
  (outputs (
    (report $execution_report)
  ))
  (steps ([]
    (
      (id llm_reasoning)
      (label "LLM reasoning")
      (kind operation)
      (operation shared.reason_about_request)
      (implementation core.echo)
      (inputs ((value $request)))
      (outputs ((value reasoning_trace)))
    )
    (
      (id generate_atomese)
      (label "Generate Atomese")
      (kind operation)
      (operation shared.generate_atomese)
      (implementation core.echo)
      (dependsOn ([] llm_reasoning))
      (inputs ((value $reasoning_trace)))
      (outputs ((value initial_atomese)))
    )
    (
      (id assess_initial_coverage)
      (label "Validate initial symbolic coverage")
      (kind operation)
      (operation shared.assess_symbolic_coverage)
      (implementation python.expression)
      (dependsOn ([] generate_atomese))
      (inputs ((context $initial_atomese)))
      (parameters ((expression "{'candidate': context, 'adequate': bool(context), 'coverage': 1.0 if bool(context) else 0.0}")))
      (outputs ((value initial_assessment)))
    )
    (
      (id repair_retry_loop)
      (label "Repair/retry candidates")
      (kind operation)
      (operation shared.repair_atomese)
      (implementation core.echo)
      (dependsOn ([] assess_initial_coverage))
      (inputs ((value $repair_candidate)))
      (foreach (
        (items $repair_candidates)
        (itemPort value)
        (maxItems 5)
      ))
      (outputs ((value repaired_candidates)))
    )
    (
      (id select_adequate_candidate)
      (label "Select first adequate repair")
      (kind operation)
      (operation shared.assess_symbolic_coverage)
      (implementation python.expression)
      (dependsOn ([] repair_retry_loop))
      (inputs ((context $repaired_candidates)))
      (parameters ((expression "([candidate for candidate in context if candidate] + [''])[0]")))
      (outputs ((value adequate_atomese)))
    )
    (
      (id assess_final_coverage)
      (label "Confirm adequate symbolic coverage")
      (kind operation)
      (operation shared.assess_symbolic_coverage)
      (implementation python.expression)
      (dependsOn ([] select_adequate_candidate))
      (inputs ((context $adequate_atomese)))
      (parameters ((expression "{'candidate': context, 'adequate': bool(context), 'coverage': 1.0 if bool(context) else 0.0}")))
      (outputs ((value final_assessment)))
    )
    (
      (id execute_and_report)
      (label "Execute and report")
      (kind operation)
      (operation shared.execute_symbolic_report)
      (implementation core.merge)
      (dependsOn ([] assess_final_coverage))
      (inputs ((left $adequate_atomese) (right $final_assessment)))
      (outputs ((value execution_report)))
    )
  ))
)
