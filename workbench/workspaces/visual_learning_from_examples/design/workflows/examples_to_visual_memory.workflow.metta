(
  (kind workflow)
  (id examples_to_visual_memory)
  (label "Examples to Visual Memory")
  (description "Capture a set of visual examples, normalize it into a stable learning batch, obtain a review decision, and publish a durable memory-silo record.")
  (inputs (
    (examples Array)
  ))
  (outputs (
    (memory $memory_silo)
  ))
  (steps ([]
    (
      (id capture_examples)
      (label "Capture examples")
      (kind operation)
      (operation shared.capture_learning_examples)
      (implementation core.echo)
      (inputs ((value $examples)))
      (outputs ((value captured_examples)))
    )
    (
      (id normalize_learning_batch)
      (label "Normalize learning batch")
      (kind operation)
      (operation shared.normalize_learning_evidence)
      (implementation core.echo)
      (dependsOn ([] capture_examples))
      (inputs ((value $captured_examples)))
      (outputs ((value normalized_examples)))
    )
    (
      (id review_examples)
      (label "Review recognizable examples")
      (kind human)
      (dependsOn ([] normalize_learning_batch))
      (form ((review ((type Object)))))
      (outputs ((review review_record)))
    )
    (
      (id publish_memory_silo)
      (label "Publish memory silo")
      (kind operation)
      (operation shared.publish_memory_record)
      (implementation core.merge)
      (dependsOn ([] normalize_learning_batch review_examples))
      (inputs ((left $normalized_examples) (right $review_record)))
      (outputs ((value memory_silo)))
    )
  ))
)
