(
  (kind workflow)
  (id arc3_rule_learning_demo)
  (label "Learn and Test an ARC3 Transformation Rule")
  (description "Capture a real before/action/after example, preserve rival rules, predict an unseen case before its outcome, and grade that prediction independently.")
  (generation (
    (operation workflow.populate_from_english)
    (englishDescriptionPath docs/WORKFLOW_DESCRIPTION.md)
    (operationCategories ([] workflow-language))
    (preflightRequired true)
  ))
  (inputs (
    (before Image)
    (after Image)
    (action Object)
    (evidence Evidence)
    (unseen_case Object)
    (observed_outcome Object)
  ))
  (outputs (
    (rules $candidate_rules)
    (prediction $unseen_prediction)
    (grade $prediction_grade)
  ))
  (steps ([]
    (
      (kind operation)
      (id capture_before)
      (label "Capture before state")
      (operation shared.capture_observation)
      (implementation core.echo)
      (inputs ((value $before)))
      (outputs ((value captured_before)))
    )
    (
      (kind operation)
      (id capture_after)
      (label "Capture independent after state")
      (operation shared.capture_observation)
      (implementation core.echo)
      (inputs ((value $after)))
      (outputs ((value captured_after)))
    )
    (
      (kind operation)
      (id analyze_transition)
      (label "Analyze before/action/after transition")
      (operation vision.transition_analysis)
      (implementation llm.complete)
      (dependsOn ([] capture_before capture_after))
      (inputs ((before $captured_before) (after $captured_after)))
      (outputs ((changes observed_changes) (correspondences object_correspondences)))
    )
    (
      (kind operation)
      (id induce_rival_rules)
      (label "Induce and retain rival rules")
      (operation vision.rule_learning)
      (implementation llm.complete)
      (dependsOn ([] analyze_transition))
      (inputs ((transitions $observed_changes) (evidence $evidence)))
      (outputs ((rules candidate_rules)))
    )
    (
      (kind human)
      (id review_rule)
      (label "Review assumptions, critiques, and evidence")
      (dependsOn ([] induce_rival_rules))
      (form ((selected_rule ((type Object)))))
      (outputs ((selected_rule reviewed_rule)))
    )
    (
      (kind operation)
      (id predict_unseen_case)
      (label "Record prediction for unseen case")
      (operation phase3.apply_learned_rule)
      (implementation llm.complete)
      (dependsOn ([] review_rule))
      (inputs ((rule $reviewed_rule) (unseen_case $unseen_case) (action $action)))
      (outputs ((prediction unseen_prediction)))
    )
    (
      (kind operation)
      (id grade_independent_outcome)
      (label "Grade later independent outcome")
      (operation phase3.grade_prediction)
      (implementation llm.complete)
      (dependsOn ([] predict_unseen_case))
      (inputs ((prediction $unseen_prediction) (observed_outcome $observed_outcome)))
      (outputs ((grade prediction_grade)))
    )
  ))
)
