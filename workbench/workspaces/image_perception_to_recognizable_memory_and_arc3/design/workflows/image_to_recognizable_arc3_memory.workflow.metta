(
  (kind workflow)
  (id image_to_recognizable_arc3_memory)
  (label "Image Perception to Recognizable Memory and ARC3")
  (description "Carry image evidence through perception and recognizable-memory staging, then bind the result to ARC3 context without discarding provenance.")
  (inputs (
    (image Image)
    (arc3_context Object)
  ))
  (outputs (
    (memory $arc3_memory)
  ))
  (steps ([]
    (
      (id capture_image)
      (label "Capture image evidence")
      (kind operation)
      (operation shared.capture_observation)
      (implementation core.echo)
      (inputs ((value $image)))
      (outputs ((value image_evidence)))
    )
    (
      (id perceive_objects)
      (label "Perceive recognizable objects")
      (kind operation)
      (operation vision.object_analysis)
      (implementation core.echo)
      (dependsOn ([] capture_image))
      (inputs ((value $image_evidence)))
      (outputs ((value perceived_objects)))
    )
    (
      (id establish_recognizable_memory)
      (label "Establish recognizable memory")
      (kind operation)
      (operation shared.establish_recognizable_memory)
      (implementation core.echo)
      (dependsOn ([] perceive_objects))
      (inputs ((value $perceived_objects)))
      (outputs ((value recognizable_memory)))
    )
    (
      (id bind_arc3_context)
      (label "Bind ARC3 context")
      (kind operation)
      (operation shared.bind_memory_context)
      (implementation core.merge)
      (dependsOn ([] establish_recognizable_memory))
      (inputs ((left $recognizable_memory) (right $arc3_context)))
      (outputs ((value arc3_memory)))
    )
  ))
)
