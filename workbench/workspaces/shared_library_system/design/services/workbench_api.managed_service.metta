((kind managed_service) (id workbench-api) (label "Workbench API") (description "Active Python API development server.") (port 8000) (healthPath /workbench/health) (launcher workbench/scripts/run_api_server.bat) (workingDirectory workbench) (commandPatterns ([] run_api_server.py uvicorn flask)) (controllable false) (allowKill false) (allowRelaunch false) (singleton true) (defaultStartup ((start true) (hiddenWindow false))))
