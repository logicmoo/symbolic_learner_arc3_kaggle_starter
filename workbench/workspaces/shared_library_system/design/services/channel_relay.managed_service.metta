((kind managed_service) (id channel-relay) (label "Mailbox Channel Relay Proxy") (description "Standalone mailbox and chat-platform bridging proxy daemon.") (port 46667) (healthPath /health) (launcher ../mailbox_channel/mailbox-server.cmd) (workingDirectory ../mailbox_channel) (commandPatterns ([] mailbox-server mailbox_channel)) (controllable true) (allowKill true) (allowRelaunch true) (singleton true) (defaultStartup ((start false) (hiddenWindow false))))
