(
  (kind system)
  (id mailbox)
  (label "Agent Mailbox")
  (provider local_mailbox)
  (systemType communication)
  (description "Exchanges durable filesystem messages and attachments through the standalone Mailbox Channel relay.")
  (enabled true)
  (capabilities ([] agent.message.send agent.message.receive attachment.transfer system.execute))
  (configuration (
    (mailboxEnvironmentVariable AGENT_MAILBOX_DIR)
    (mailboxDirectory "C:\\snet\\PeTTa\\repos\\mailbox_channel\\mailbox")
    (adapterScript "..\\mailbox_channel\\mailbox-client.cmd")
    (channelRelayDaemon "..\\mailbox_channel\\mailbox-server.cmd")
    (channelRelayControlApi /api/system/services/mailbox_server)
    (channelRelayRecipient mailbox_server)
    (channelRelayHealthUrl "http://127.0.0.1:46667/health")
    (localIdentity symbolic-workbench-codex)
    (corePeer omegaclaw-core-codex)
    (minPeer omegaclaw-min)
  ))
)
