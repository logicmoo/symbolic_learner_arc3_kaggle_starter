(
  (kind artifact_category)
  (id topics.agents)
  (label "Agents")
  (description "Operations whose topic is agents.")
  (path agents)
  (trees ([]
    operations
  ))
  (query (
    (kinds ([]
      operation
    ))
    (where (
      (topics (
        (contains agents)
      ))
    ))
  ))
  (parentMode show)
)

