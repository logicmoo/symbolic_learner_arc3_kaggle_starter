(
  (kind operation)
  (categories ([] workflow-language control-flow conditionals branching))
  (id control.if_cond.jumpt_branch)
  (label "If Condition, Jump Branch")
  (description "Evaluate a declared condition and branch to an existing workflow step when it matches; otherwise continue through the declared fall-through path.")
  (implementation workflow.control.if_cond.jumpt_branch)
  (inputs (
    (condition Any)
    (operator String)
    (compareTo Any)
    (targetStepId String)
    (elseStepId String)
  ))
  (outputs (
    (matched Boolean)
    (selectedStepId String)
    (evaluatedCondition Any)
  ))
  (parameters (
    (supportedOperators ([] truthy falsy empty not_empty equals not_equals less_than less_than_or_equal greater_than greater_than_or_equal))
    (requiresExistingTarget true)
    (requiresExplicitFallThrough true)
    (allowsBackwardTarget true)
    (backwardTargetRequiresBoundedRegion true)
  ))
)
(
  (kind operation)
  (categories ([] workflow-language control-flow conditionals invocation))
  (id control.if_cond.do_operation)
  (label "If Condition, Do Operation")
  (description "Evaluate a declared condition and invoke an existing semantic operation when it matches; otherwise return an explicit skipped result without inventing an implementation.")
  (implementation workflow.control.if_cond.do_operation)
  (inputs (
    (condition Any)
    (operator String)
    (compareTo Any)
    (operationId String)
    (operationInputs Object)
  ))
  (outputs (
    (matched Boolean)
    (called Boolean)
    (operationId String)
    (result Any)
  ))
  (parameters (
    (supportedOperators ([] truthy falsy empty not_empty equals not_equals less_than less_than_or_equal greater_than greater_than_or_equal))
    (requiresCatalogOperation true)
    (resolveImplementationAtRuntime true)
    (preserveSkippedResult true)
  ))
)
