(
  (kind operation)
  (categories ([] workflow-language control-flow loops))
  (id control.while)
  (label "While Condition Holds")
  (description "Repeat a workflow region while its condition matches the selected operator, stopping at a required iteration bound.")
  (implementation workflow.control.while)
  (inputs ((loopId String) (condition Any) (operator String) (compareTo Any) (targetStepId String) (exitStepId String) (maxIterations Number) (retainedValues Array) (resetValues Array) (accumulatedValues Array) (exportedValues Array)))
  (outputs ((iterations Number) (completed Boolean) (lastCondition Any)))
  (parameters ((requiresBound true) (supportedOperators ([] truthy not_empty equals less_than))))
)
(
  (kind operation)
  (categories ([] workflow-language control-flow loops))
  (id control.for_each)
  (label "For Each Item")
  (description "Repeat a workflow region once for each supplied item, stopping at a required item bound.")
  (implementation workflow.control.for_each)
  (inputs ((loopId String) (items Array) (itemPort String) (indexPort String) (targetStepId String) (exitStepId String) (maxItems Number) (retainedValues Array) (resetValues Array) (accumulatedValues Array) (exportedValues Array)))
  (outputs ((iterations Number) (completed Boolean) (lastItem Any)))
  (parameters ((requiresBound true)))
)
